// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// 预测市场主表
model Market {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  category    String   // TECH, FINANCE, SPORTS, ENTERTAINMENT, CULTURE, POLITICS, CRYPTO
  status      String   // ACTIVE, CLOSED, SUCCESSFUL, FAILED
  archived    Boolean  @default(false)

  // 时间字段
  closeDate   DateTime
  resolveDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // AI 分析字段
  atypicaPickId      String?
  atypicaAnalysis    String?  @db.Text
  atypicaSummary     String?
  atypicaAnalysisUrl String?  // Atypica 分析报告链接
  atypicaPodcastUrl  String?
  accuracyScore      Float?

  // 外部数据源
  externalSource String?
  externalData   Json?   // 存储完整的 Polymarket 原始数据
  polyMarketUrl  String?
  polyMarketIcon String?

  // 统计字段
  viewCount   Int     @default(0)
  shareCount  Int     @default(0)
  poolAmount  Float?
  poolCurrency String? @default("USD")

  // 关联选项
  options     Option[]
  snapshots   PositionSnapshot[]
  tweets      Tweet[]

  @@index([status])
  @@index([category])
  @@index([closeDate])
}

// 预测选项表
enum PostType {
  BUY
  SELL
  REVENUE
  ANALYSIS
}

model TwitterAccount {
  id            String   @id @default(cuid())
  handle        String   @unique
  twitterUserId String?  @unique
  isActive      Boolean  @default(true)
  lastSyncAt    DateTime?

  tweets        Tweet[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Tweet {
  id            String   @id @default(cuid())
  accountId     String
  account       TwitterAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  marketId      String?
  market        Market?  @relation(fields: [marketId], references: [id], onDelete: SetNull)

  tweetId       String   @unique
  text          String   @db.Text
  url           String
  postedAt      DateTime

  type          PostType?
  rawJson       Json?
  isVisible     Boolean  @default(false)
  mediaUrls     String[] @default([])
  outLinks      String[] @default([])
  likeCount     Int?
  replyCount    Int?
  retweetCount  Int?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([accountId])
  @@index([marketId])
  @@index([type, postedAt])
}

model Option {
  id           String   @id @default(cuid())
  marketId     String
  market       Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  text         String
  externalProb Float?   // 外部市场概率 (0-1)
  atypicaProb  Float?   // Atypica AI 预测概率 (0-1)
  isWinner     Boolean  @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([marketId])
}

// 持仓快照表
model PositionSnapshot {
  id                    String   @id @default(cuid())
  marketId              String
  market                Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  // 快照数据
  timestamp             DateTime // 快照时间（精确到小时）
  percentRealizedPnl    Float    // 收益率
  currentValue          Float    // 当前价值
  winValue              Float    // Win value

  createdAt             DateTime @default(now())

  @@index([marketId])
  @@index([timestamp])
  @@index([marketId, timestamp])
}
